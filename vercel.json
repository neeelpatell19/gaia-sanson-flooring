{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/categories",
      "destination": "https://sansonfloorings.com/",
      "statusCode": 301
    },
    {
      "source": "/categories/carpet-tiles",
      "destination": "https://sansonfloorings.com/carpet-tiles",
      "statusCode": 301
    },
    {
      "source": "/categories/broadloom-carpets",
      "destination": "https://sansonfloorings.com/broadloom-carpets",
      "statusCode": 301
    },
    {
      "source": "/categories/acoustic-tiles",
      "destination": "https://sansonfloorings.com/acoustic-pet-panels",
      "statusCode": 301
    },
    {
      "source": "/categories/artificial-multiturf",
      "destination": "https://sansonfloorings.com/artificial-grass",
      "statusCode": 301
    },
    {
      "source": "/artificial-grass/multisports-grass",
      "destination": "https://sansonfloorings.com/artificial-grass/multiturf",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.sansonfloorings.com"
        }
      ],
      "destination": "https://sansonfloorings.com/$1",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/pdfs/:file(GAIA_.*\\.pdf)",
      "destination": "https://prepseed-files.prepseed.com/gaia/pdfs/:file"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(Images|videos|pdfs)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/pdfs/GAIA_AANGAN.pdf",
      "headers": [
        {
          "key": "Link",
          "value": "<https://sansonfloorings.com/carpet-tiles/aangan>; rel=\"canonical\""
        }
      ]
    },
